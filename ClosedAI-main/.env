LLM_PROVIDER=openai

 

# Azure AI Foundry serverless — GPT-5.2 (OpenAI-compatible endpoint)

# Foundry's serverless endpoints expose an OpenAI-compatible API, so the

# "openai" provider is used (not "azure", whose backend path only understands

# classic openai.azure.com resource URLs). The backend auto-routes gpt-5.2

# through the Responses API. Endpoint = the vault secret Group1OpenAIEndPoint

# with the trailing "/responses" stripped.

OPENAI_API_KEY=CVqXgwVR2h1t1p9qbFGAmFv5otPfHE0Mp7TSXsoLVMk9w4jZKRXgJQQJ99CHAC4f1cMXJ3w3AAAAACOGCAPS

OPENAI_MODEL=gpt-5.2

OPENAI_BASE_URL=https://sharedfoundry.services.ai.azure.com/openai/v1

 

AZURE_SEARCH_ENDPOINT=https://closedai-search.search.windows.net
AZURE_SEARCH_API_KEY=FzTpvz7IppqbOr99gZDI4uHvY5pp2OcoOKIuCTi48xAzSeDJgdJH
AZURE_SEARCH_INDEX=company-policies

 

# Native Gmail OAuth (Tools tab). CLI MCP is opt-in only.

GMAIL_MCP_ENABLED=false

GMAIL_MCP_COMMAND=npx

GMAIL_MCP_ARGS="-y @gongrzhe/server-gmail-autoauth-mcp"

 

# Google OAuth — Client ID/Secret can also come from backend/gcp-oauth.keys.json

GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

DEFAULT_USER_ID=test_user

 

GOOGLE_CLIENT_ID=349766906172-ua2bk9t4nlkfb3k938umvfo2u01413d2.apps.googleusercontent.com

GOOGLE_CLIENT_SECRET=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

FRONTEND_URL=http://localhost:3001

 

# Login SSO (AuthGate) — separate from Gmail Tools OAuth callback

GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

JWT_SECRET=hr-copilot-local-dev-jwt-secret-change-in-azure

JWT_EXPIRE_DAYS=7

JWT_EXPIRE_HOURS=168

 

# Phase 16 — employee Cosmos (seeded data is in database closedai-db / employees)

USE_MOCK_AZURE=false

COSMOS_CONNECTION_STRING="AccountEndpoint=https://closedai-dev-cosmos.documents.azure.com:443/;AccountKey=B3ox9ptryWRyQ4SweDw9WnkegBlPUqjc1oG…

COSMOS_ENDPOINT="https://closedai-dev-cosmos.documents.azure.com:443/"

COSMOS_KEY="B3ox9ptryWRyQ4SweDw9WnkegBlPUqjc1oGT2asBV5rZf5ois7MpsjExdTxlbTjNfUGiAiydpLmxACDbJ1ZPLQ=="

COSMOS_DATABASE_NAME="closedai-db"

COSMOS_CONTAINER_NAME="employees"

# Aliases for the cosmos-db MCP marketplace plugin
# (HRAgent_Main/marketplaces/integrations/cosmos-db), whose vendored server
# reads these exact names (COSMOS_URI/COSMOS_DATABASE/COSMOS_CONTAINER) per
# the upstream AzureCosmosDB sample's CLI/env contract. Kept as separate
# aliases rather than renaming the vars above, since nothing else in this
# repo currently reads COSMOS_ENDPOINT/COSMOS_DATABASE_NAME/COSMOS_CONTAINER_NAME.
COSMOS_URI="https://closedai-dev-cosmos.documents.azure.com:443/"
COSMOS_DATABASE="closedai-db"
COSMOS_CONTAINER="employees"


